#!/usr/bin/env bash
#SBATCH --job-name=relh-classic-native-hint-prior-build
#SBATCH --partition=b300
#SBATCH --nodelist=metta-fabric-b300-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBATCH --time=00:20:00
#SBATCH --nice=100
#SBATCH --chdir=/tmp
#SBATCH --output=/var/tmp/relh-generals-recovery/native-hint-prior-build-%j.log
set -euo pipefail
python3 - /var/tmp/relh-generals-recovery <<'STAGEPY'
import base64,io,sys,tarfile
from pathlib import Path
root=Path(sys.argv[1])
archive=tarfile.open(fileobj=io.BytesIO(base64.b64decode("")),mode='r:gz')
for entry in archive:
    path=root/("native-hint-prior-"+entry.name+"-20260927")
    data=archive.extractfile(entry).read()
    if path.exists():
        assert path.read_bytes()==data
    else:
        with path.open('xb') as handle:
            handle.write(data)
STAGEPY
srun --nodes=1 --ntasks=1 --gres=gpu:1 --cpus-per-task=16 bash -c '
set -euo pipefail
w=/tmp/relh-generals-coworld
disk=/var/tmp/relh-generals-recovery
out=$disk/native-hint-prior-build-$SLURM_JOB_ID
mkdir -p "$out"
printf "%s  %s\n" 24034ec915b7b91a8a3e9333ce12b3dcbd9e517c0eb7c828cdf500c297d2fc06 "$w/metta-device-wide-source.tar.gz" | sha256sum -c -
printf "%s  %s\n" 2ed399dc6573db889290808f53f5727cf77147fabede9209a1c925b94923f9b4 "$disk/native-hint-prior-puffer.py-20260927" | sha256sum -c -
printf "%s  %s\n" 91d65635419ebc101be6b77fedb63903bcdfaaea4d3c375cd7acad458e2e1ef6 "$disk/native-hint-prior-model_config.py-20260927" | sha256sum -c -
printf "%s  %s\n" 21e6ad1c095e3c65038dda8c4eeeba0959d0141cb102f1edab7b8781459489a2 "$disk/native-hint-prior-native_build.py-20260927" | sha256sum -c -
printf "%s  %s\n" 71058a2f0b10a608bcf093dd35d0986b20aae3060e69592c2b5bec77814687e7 "$disk/native-hint-prior-hint_prior.cuh-20260927" | sha256sum -c -
python3 - "$disk/native-policy-feedforward-state-fixed-33m-probe-v2-26484/build/build.json" "$out/config.json" <<"PY"
import json,sys
from pathlib import Path
config=json.loads(Path(sys.argv[1]).read_text())["config"]
assert config["environment_backend"]=="cuda" and config["precision"]=="float32" and config["fabric"] is None
assert config["python_environment"]["spec"]["observation_size"]==6174
assert config["python_environment"]["spec"]["action_sizes"]==[1765,2]
config["native_hint_prior"]=dict(channels=14,cells=441,move_channel=4,pass_channel=3,split_channel=2,
    move_scale=10.666666666666666,pass_scale=10.666666666666666,split_scale=12.0)
Path(sys.argv[2]).write_text(json.dumps(config)+"\n")
PY
IFS=, read -r -a allocated_gpus <<< "$SLURM_STEP_GPUS"
test "${#allocated_gpus[@]}" -eq 1
usage=$(nvidia-smi --query-gpu=uuid,memory.used,utilization.gpu --format=csv,noheader,nounits)
mapfile -t rows <<< "$usage"
test "${#rows[@]}" -eq 1
IFS=, read -r gpu memory utilization <<< "${rows[0]}"
gpu=${gpu//[[:space:]]/}; memory=${memory//[[:space:]]/}; utilization=${utilization//[[:space:]]/}
[[ "$gpu" == GPU-* && "$memory" =~ ^[0-9]+$ && "$utilization" =~ ^[0-9]+$ ]]
(( memory < 2048 && utilization < 20 ))
name=relh-classic-native-hint-prior-build-$SLURM_JOB_ID
cleanup() { docker stop -t 5 "$name" >/dev/null 2>&1 || true; }
trap cleanup EXIT
trap "exit 143" TERM
timeout -k 30s 16m docker run --rm --name "$name" --gpus "device=$gpu" --cpus=16 \
    --ulimit core=0:0 --user "$(id -u):$(id -g)" \
    -v "$w:/work" -v "$out:/recovery-output" -v "$disk:/recovery:ro" \
    -v "$disk/native-hint-prior-puffer.py-20260927:/work/metta-device-wide-source/metta_training/puffer.py:ro" \
    -v "$disk/native-hint-prior-model_config.py-20260927:/work/metta-device-wide-source/metta_training/model_config.py:ro" \
    -v "$disk/native-hint-prior-native_build.py-20260927:/work/metta-device-wide-source/metta_training/native_build.py:ro" \
    -v "$disk/native-hint-prior-hint_prior.cuh-20260927:/work/metta-device-wide-source/metta_training/native/hint_prior.cuh:ro" \
    -v "$disk/metta_puffer-terminal-boundary-fixed-20260927.py:/work/source-normalized-16245/integrations/metta_puffer.py:ro" \
    -v "$disk/puffer_codec-calibrated-v1.py:/work/source-normalized-16245/integrations/puffer_codec.py:ro" \
    -v /var/tmp/relh-generals-jax-cache:/cache \
    -v /tmp/relh-generals-gpu/runtime:/work/runtime:ro \
    -v /tmp/relh-generals-gpu/source-gpu:/work/oldsource:ro -w /work \
    -e XDG_CACHE_HOME=/recovery-output/cache \
    -e PYTHONPATH=/work/metta-device-wide-source:/work/runtime:/work/source-normalized-16245:/work/oldsource \
    -e JAX_COMPILATION_CACHE_DIR=/cache -e JAX_PLATFORMS=cuda,cpu \
    -e XLA_PYTHON_CLIENT_PREALLOCATE=false -e LD_LIBRARY_PATH=/work/runtime/nvidia/cu13/lib \
    relh-generals-b300:20260923b bash /work/source-normalized-16245/integrations/run_puffer_gpu.sh build \
      --config /recovery-output/config.json --output /recovery-output/build > "$out/container.log" 2>&1
python3 - "$out/build" <<"PY"
import hashlib,json,sys
from pathlib import Path
build=Path(sys.argv[1]); manifest=json.loads((build/"build.json").read_text())
assert hashlib.sha256((build/"puffer").read_bytes()).hexdigest()==manifest["binary_sha256"]
assert manifest["config"]["native_hint_prior"]["cells"]==441
assert manifest["config"]["fabric"] is None
source=(build/"source/src/algo.cu").read_text()
assert source.count("metta_hint_prior<<<")==2
assert (build/"source/src/metta_hint_prior.cuh").is_file()
print("NATIVE_HINT_PRIOR_BUILD_OK",manifest["binary_sha256"],flush=True)
PY
'
