FROM nvidia/cuda:13.0.2-devel-ubuntu24.04@sha256:0eee3094c71518ad31d011a594ae6ed6de72959ee07e318cb31cffe71690e90c

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev git curl ca-certificates \
    build-essential clang ccache libomp-dev libgl1 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/lib/x86_64-linux-gnu/libomp.so.5 /usr/lib/x86_64-linux-gnu/libomp5.so \
    && ln -sf /usr/lib/x86_64-linux-gnu/libGL.so.1 /usr/lib/x86_64-linux-gnu/libGL.so
COPY requirements.lock /tmp/requirements.lock
RUN python3 -m venv /opt/generals && /opt/generals/bin/pip install --no-cache-dir -r /tmp/requirements.lock


# Pure source only: no copied virtualenv, bytecode, binary wheel or CUDA cache.
COPY source /opt/generals-source
RUN chmod -R a+rX /opt/generals-source
ENV PATH=/opt/generals/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV PYTHONPATH=/opt/generals-source
ENV LD_LIBRARY_PATH=/opt/generals/lib/python3.12/site-packages/nvidia/cu13/lib:/opt/generals/lib/python3.12/site-packages/nvidia/cudnn/lib:/opt/generals/lib/python3.12/site-packages/nvidia/nccl/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64
RUN python -m pip check && python -c \
    'import numpy, pydantic, msgpack, importlib.metadata as m; assert m.version("jax") == "0.11.0"; print("IMAGE_DEPENDENCIES_OK")'
# The cloud builder is native AMD64. The Mac-only ARM QEMU helper must not
# execute here; the same preparation gate runs directly on the builder CPU.

COPY pilot /opt/pilot
COPY GENERALS_CONTEXT_SHA256 /opt/context-files.sha256
RUN sha256sum --quiet -c /opt/context-files.sha256
ENV PYTHONPATH=/opt/pilot/source:/opt/generals-source
WORKDIR /opt/pilot
RUN --mount=type=tmpfs,target=/work,size=1073741824 JAX_PLATFORMS=cpu /opt/generals/bin/python /opt/pilot/cpu_prepare.py > /opt/pilot/cpu-prepare.log 2>&1 || (cat /opt/pilot/cpu-prepare.log; exit 1)
RUN if test -d /work; then rmdir /work; fi
CMD ["/opt/generals/bin/python", "-m", "integrations.autoresearch_classic_job"]
