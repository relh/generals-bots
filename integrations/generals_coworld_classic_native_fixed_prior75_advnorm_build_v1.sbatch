#!/usr/bin/env bash
#SBATCH --job-name=relh-classic-native-fixed-prior75-advnorm-build-v1
#SBATCH --partition=b300
#SBATCH --nodelist=metta-fabric-b300-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=00:20:00
#SBATCH --nice=2147483645
#SBATCH --chdir=/tmp
#SBATCH --output=/var/tmp/relh-generals-recovery/native-fixed-prior75-advnorm-build-v1-%j.log
set -euo pipefail

# Mandatory user policy: verify lowest scheduling priority before workload startup.
slurm_task_priority_record=$(scontrol show job -o "${SLURM_JOB_ID:?}")
[[ " $slurm_task_priority_record " == *" Nice=2147483645 "* ]] || { printf 'Lowest Slurm Nice verification failed\n' >&2; exit 1; }
slurm_task_priority=unknown
for slurm_task_field in $slurm_task_priority_record; do
  case "$slurm_task_field" in Priority=*) slurm_task_priority=${slurm_task_field#Priority=} ;; esac
done
[[ "$slurm_task_priority" =~ ^[0-9]+$ ]] || exit 1
printf 'SLURM_PRIORITY_READBACK JobId=%s Nice=2147483645 Priority=%s\n' "$SLURM_JOB_ID" "$slurm_task_priority" >&2
unset slurm_task_priority_record slurm_task_field

export TMPDIR=/var/tmp/relh-generals-recovery
mkdir -p "$TMPDIR"
python3 - /var/tmp/relh-generals-recovery <<'STAGEPY'
import base64,io,sys,tarfile
from pathlib import Path
root=Path(sys.argv[1])
archive=tarfile.open(fileobj=io.BytesIO(base64.b64decode("")),mode='r:gz')
for entry in archive:
    path=root/("native-hint-prior-"+entry.name+"-v2-20260927")
    data=archive.extractfile(entry).read()
    if path.exists():
        assert path.read_bytes()==data
    else:
        with path.open('xb') as handle:
            handle.write(data)
STAGEPY
python3 - /var/tmp/relh-generals-recovery <<'ADVSTAGE'
import base64,sys
from pathlib import Path
root=Path(sys.argv[1])
path=root/'native-advnorm-native_build-v2-20260927.py'
data=base64.b64decode('')
if path.exists():
    assert path.read_bytes()==data
else:
    with path.open('xb') as handle: handle.write(data)
path=root/'native-advnorm-learner-v3-20260927.cuh'
data=base64.b64decode('')
if path.exists():
    assert path.read_bytes()==data
else:
    with path.open('xb') as handle: handle.write(data)
path=root/'native-advnorm-replay-v2-20260927.cuh'
data=base64.b64decode('')
if path.exists():
    assert path.read_bytes()==data
else:
    with path.open('xb') as handle: handle.write(data)
path=root/'native-advnorm-advantage.cuh-20260927'
data=base64.b64decode('')
if path.exists():
    assert path.read_bytes()==data
else:
    with path.open('xb') as handle: handle.write(data)
ADVSTAGE
python3 - /var/tmp/relh-generals-recovery <<'LEARNERSTAGE'
import base64,sys
from pathlib import Path
path=Path(sys.argv[1])/'native-advnorm-learner-python-v1-20260927.py'
data=base64.b64decode('')
if path.exists():
    assert path.read_bytes()==data
else:
    with path.open('xb') as handle: handle.write(data)
LEARNERSTAGE
srun --nice=2147483645 --nodes=1 --ntasks=1 --gres=gpu:1 --cpus-per-task=8 bash -c '
set -euo pipefail
w=/tmp/relh-generals-coworld
disk=/var/tmp/relh-generals-recovery
out=$disk/native-fixed-prior75-advnorm-build-v1-$SLURM_JOB_ID
mkdir -p "$out"
printf "%s  %s\n" 24034ec915b7b91a8a3e9333ce12b3dcbd9e517c0eb7c828cdf500c297d2fc06 "$w/metta-device-wide-source.tar.gz" | sha256sum -c -
printf "%s  %s\n" 2ed399dc6573db889290808f53f5727cf77147fabede9209a1c925b94923f9b4 "$disk/native-hint-prior-puffer.py-v2-20260927" | sha256sum -c -
printf "%s  %s\n" 91d65635419ebc101be6b77fedb63903bcdfaaea4d3c375cd7acad458e2e1ef6 "$disk/native-hint-prior-model_config.py-v2-20260927" | sha256sum -c -
printf "%s  %s\n" 64125339c8055170adf4eda776f236486fbbbb58814c07d5c84b3b330c8cc80a "$disk/native-advnorm-native_build-v2-20260927.py" | sha256sum -c -
printf "%s  %s\n" 99cdd3fc87c0aa95b775410aaebf2724b555d583db11051b102837489fd656ab "$disk/native-advnorm-learner-python-v1-20260927.py" | sha256sum -c -
printf "%s  %s\n" 71058a2f0b10a608bcf093dd35d0986b20aae3060e69592c2b5bec77814687e7 "$disk/native-hint-prior-hint_prior.cuh-v2-20260927" | sha256sum -c -
printf "%s  %s\n" a16ad89ea17fea502be4ac4478d2c366883846f1039f3a6c426ff39cd21ceea6 "$disk/native-advnorm-advantage.cuh-20260927" | sha256sum -c -
printf "%s  %s\n" 025ca8eeaacaa533826387f36551f6ae5a156f56cc3eb8b79d6c07d0e16be698 "$disk/native-advnorm-learner-v3-20260927.cuh" | sha256sum -c -
printf "%s  %s\n" cc838fd18bf92a2a8b42cc5f66ae84811eaa635d438ad4bb34527dc1fd28cb1b "$disk/native-advnorm-replay-v2-20260927.cuh" | sha256sum -c -
python3 - "$disk/native-policy-feedforward-state-fixed-33m-probe-v2-26484/build/build.json" "$out/config.json" <<"PY"
import json,sys
from pathlib import Path
config=json.loads(Path(sys.argv[1]).read_text())["config"]
assert config["environment_backend"]=="cuda" and config["precision"]=="float32" and config["fabric"] is None
assert config["python_environment"]["spec"]["observation_size"]==6174
assert config["python_environment"]["spec"]["action_sizes"]==[1765,2]
config["native_hint_prior"]=dict(channels=14,cells=441,move_channel=4,pass_channel=3,split_channel=2,
    move_scale=7.5,pass_scale=7.5,split_scale=8.4375)
options=config["python_environment"]["options"]
assert options["coworld_classic"] and options["factorized_actions"]
assert options["shaping_gamma"]==.999 and options["balance_opponent_sides"]
assert options["prior_hint_features"] and options["expander_hint_features"] and options["context_hint_features"]
Path(sys.argv[2]).write_text(json.dumps(config)+"\n")
PY
IFS=, read -r -a allocated_gpus <<< "$SLURM_STEP_GPUS"
test "${#allocated_gpus[@]}" -eq 1
usage=$(nvidia-smi --query-gpu=uuid,memory.used,utilization.gpu --format=csv,noheader,nounits)
mapfile -t rows <<< "$usage"
test "${#rows[@]}" -eq 1
IFS=, read -r gpu memory utilization <<< "${rows[0]}"
gpu=${gpu//[[:space:]]/}; memory=${memory//[[:space:]]/}; utilization=${utilization//[[:space:]]/}
[[ "$gpu" == GPU-* && "$memory" =~ ^[0-9]+$ && "$utilization" =~ ^[0-9]+$ ]]
(( memory < 2048 && utilization < 20 ))
name=relh-classic-native-fixed-prior75-advnorm-build-v1-$SLURM_JOB_ID
cleanup() { docker stop -t 5 "$name" >/dev/null 2>&1 || true; }
trap cleanup EXIT
trap "exit 143" TERM
timeout -k 30s 16m docker run --rm --name "$name" --gpus "device=$gpu" --cpus=8 \
    --ulimit core=0:0 --user "$(id -u):$(id -g)" \
    -v "$w:/work" -v "$out:/recovery-output" -v "$disk:/recovery:ro" \
    -v "$disk/native-hint-prior-puffer.py-v2-20260927:/work/metta-device-wide-source/metta_training/puffer.py:ro" \
    -v "$disk/native-hint-prior-model_config.py-v2-20260927:/work/metta-device-wide-source/metta_training/model_config.py:ro" \
    -v "$disk/native-advnorm-native_build-v2-20260927.py:/work/metta-device-wide-source/metta_training/native_build.py:ro" \
    -v "$disk/native-advnorm-learner-python-v1-20260927.py:/work/metta-device-wide-source/metta_training/learner.py:ro" \
    -v "$disk/native-advnorm-advantage.cuh-20260927:/work/metta-device-wide-source/metta_training/native/advantage.cuh:ro" \
    -v "$disk/native-advnorm-replay-v2-20260927.cuh:/work/metta-device-wide-source/metta_training/native/replay.cuh:ro" \
    -v "$disk/native-advnorm-learner-v3-20260927.cuh:/work/metta-device-wide-source/metta_training/native/learner.cuh:ro" \
    -v "$disk/native-hint-prior-hint_prior.cuh-v2-20260927:/work/metta-device-wide-source/metta_training/native/hint_prior.cuh:ro" \
    -v "$disk/metta_puffer-terminal-boundary-fixed-20260927.py:/work/source-normalized-16245/integrations/metta_puffer.py:ro" \
    -v "$disk/puffer_codec-calibrated-v1.py:/work/source-normalized-16245/integrations/puffer_codec.py:ro" \
    -v /var/tmp/relh-generals-jax-cache:/cache \
    -v /tmp/relh-generals-gpu/runtime:/work/runtime:ro \
    -v /tmp/relh-generals-gpu/source-gpu:/work/oldsource:ro -w /work \
    -e XDG_CACHE_HOME=/recovery-output/cache \
    -e PYTHONPATH=/work/metta-device-wide-source:/work/runtime:/work/source-normalized-16245:/work/oldsource \
    -e JAX_COMPILATION_CACHE_DIR=/cache -e JAX_PLATFORMS=cuda,cpu \
    -e XLA_PYTHON_CLIENT_PREALLOCATE=false -e LD_LIBRARY_PATH=/work/runtime/nvidia/cu13/lib \
    relh-generals-b300:20260923b bash /work/source-normalized-16245/integrations/run_puffer_gpu.sh build \
      --config /recovery-output/config.json --output /recovery-output/build > "$out/container.log" 2>&1
python3 - "$out/build" <<"PY"
import hashlib,json,sys
from pathlib import Path
build=Path(sys.argv[1]); manifest=json.loads((build/"build.json").read_text())
assert hashlib.sha256((build/"puffer").read_bytes()).hexdigest()==manifest["binary_sha256"]
assert manifest["config"]["native_hint_prior"]["cells"] == 441
assert manifest["config"]["fabric"] is None
source=(build/"source/src/algo.cu").read_text()
assert source.count("metta_hint_prior<<<") == 2
assert "metta_standardize_ppo_advantages" in (build/"source/src/pufferl.cu").read_text()
assert "norm_adv = 0" in (build/"source/config/default.ini").read_text()
assert (build/"source/src/metta_hint_prior.cuh").is_file()
print("NATIVE_FIXED_ADV_NORM_BUILD_OK",manifest["binary_sha256"],flush=True)
PY
'
