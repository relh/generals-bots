# syntax=docker/dockerfile:1.7
# Build with --build-context policy=<exported frozen spatial policy bundle>.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 JAX_PLATFORMS=cpu \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 HOME=/tmp XDG_CACHE_HOME=/tmp/.cache \
    GENERALS_POLICY_BUNDLE=/app/policy
WORKDIR /app
RUN pip install --no-cache-dir \
    jax==0.11.0 jaxlib==0.11.0 numpy==2.4.6 websockets==16.0
COPY generals /app/generals
COPY integrations/__init__.py integrations/puffer_codec.py /app/integrations/
COPY integrations/spatial_action_sampling.py integrations/spatial_policy_bundle.py /app/integrations/
COPY integrations/native_spatial_asset.py integrations/learner_checkpoint.py integrations/classic_contract.py /app/integrations/
COPY integrations/spatial_context_geometry.py integrations/spatial_exploration.py /app/integrations/
COPY integrations/softmax/__init__.py integrations/softmax/protocol.py integrations/softmax/neural_codec.py integrations/softmax/neural_player.py /app/integrations/softmax/
COPY --from=policy / /app/policy/
RUN chmod -R a+rX /app
USER 10001:10001
CMD ["python", "-m", "integrations.softmax.neural_player"]
