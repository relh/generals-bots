#!/usr/bin/env bash
#SBATCH --job-name=relh-classic-native-raw-advnorm-r4-ent0-8m-v5-sampled-quality
#SBATCH --partition=b300
#SBATCH --nodelist=metta-fabric-b300-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=00:35:00
#SBATCH --nice=100
#SBATCH --chdir=/tmp
#SBATCH --output=/var/tmp/relh-generals-recovery/native-raw-advnorm-r4-ent0-8m-v5-sampled-quality-%j.log
set -euo pipefail
export TMPDIR=/var/tmp/relh-generals-recovery
mkdir -p "$TMPDIR"
python3 - /var/tmp/relh-generals-recovery <<'STAGE'
import base64,sys
from pathlib import Path
path=Path(sys.argv[1])/'evaluate_coworld_frozen_greedy-advnorm-20260927.py'
data=base64.b64decode('')
if path.exists():
    assert path.read_bytes()==data
else:
    with path.open('xb') as handle: handle.write(data)
STAGE
srun --nodes=1 --ntasks=1 --gres=gpu:1 --cpus-per-task=8 bash -s <<'NODE'
set -euo pipefail
w=/tmp/relh-generals-coworld
disk=/var/tmp/relh-generals-recovery
job=$SLURM_JOB_ID
out=$disk/native-raw-advnorm-r4-ent0-8m-v5-sampled-quality-$job
mkdir -p "$out"
printf '%s  %s\n' dbaf18bc37ae4c276eac6fd78b25a5a233fbd5f32b4a0ef111404f12f850e8a1 "$disk/evaluate_coworld_frozen_greedy-advnorm-20260927.py" | sha256sum -c -
printf '%s  %s\n' f3a5b281a1b648c1f93db9e0033ceab578207f74e26f521b8e159253df265f9a "$disk/native_puffer_policy-fixed-prior-20260927.py" | sha256sum -c -
run=$disk/native-raw-advnorm-r4-ent0-8m-v5-26947/run
build=$disk/native-raw-advnorm-build-v5-26943/build/build.json
test -f "$run/completed.json"
python3 - "$run" "$build" "$out/identities.json" <<'PYINNER'
import hashlib,json,sys
from pathlib import Path
run,build,out=map(Path,sys.argv[1:]); record=json.loads((run/'training.json').read_text())
assert record['build']==json.loads(build.read_text())
initial=run/'checkpoints/metta_generals/run/0000000002097152.bin'
final=run/'checkpoints/metta_generals/run/0000000008388608.bin'
identity=json.loads(Path(str(final)+'.learner.json').read_text())
assert hashlib.sha256(final.read_bytes()).hexdigest()==identity['policy_sha256']
assert hashlib.sha256((run/'training.json').read_bytes()).hexdigest()==identity['run_sha256']
refs={'initial':dict(checkpoint=str(initial),sha256=hashlib.sha256(initial.read_bytes()).hexdigest()),
      'final':dict(checkpoint=str(final),sha256=identity['policy_sha256'])}
out.write_text(json.dumps(refs)+'\n')
print(json.dumps(refs),flush=True)
PYINNER
IFS=, read -r -a allocated_gpus <<< "$SLURM_STEP_GPUS"
test "${#allocated_gpus[@]}" -eq 1
usage=$(nvidia-smi --query-gpu=uuid,memory.used,utilization.gpu --format=csv,noheader,nounits)
mapfile -t rows <<< "$usage"
test "${#rows[@]}" -eq 1
IFS=, read -r gpu memory utilization <<< "${rows[0]}"
gpu=${gpu//[[:space:]]/}; memory=${memory//[[:space:]]/}; utilization=${utilization//[[:space:]]/}
[[ "$gpu" == GPU-* && "$memory" =~ ^[0-9]+$ && "$utilization" =~ ^[0-9]+$ ]]
(( memory < 2048 && utilization < 20 ))
name=relh-classic-native-raw-advnorm-r4-ent0-8m-v5-sampled-quality-$job
cleanup() { docker stop -t 5 "$name" >/dev/null 2>&1 || true; }
trap cleanup EXIT
trap 'exit 143' TERM
for tag in final; do
    checkpoint=$(python3 - "$out/identities.json" "$tag" <<'PYREF'
import json,sys
print(json.load(open(sys.argv[1]))[sys.argv[2]]['checkpoint'])
PYREF
)
    digest=$(python3 - "$out/identities.json" "$tag" <<'PYREF'
import json,sys
print(json.load(open(sys.argv[1]))[sys.argv[2]]['sha256'])
PYREF
)
    for opponent in random expander_harvester; do
        timeout -k 30s 5m docker run --rm --name "$name" --gpus "device=$gpu" --cpus=8 \
            --ulimit core=0:0 --user "$(id -u):$(id -g)" \
            -v "$w:/work" -v "$disk:/recovery" -v "$out:/recovery-output" \
            -v "$disk/native-hint-prior-puffer.py-v2-20260927:/work/metta-device-wide-source/metta_training/puffer.py:ro" \
            -v "$disk/native-hint-prior-model_config.py-v2-20260927:/work/metta-device-wide-source/metta_training/model_config.py:ro" \
            -v "$disk/native-advnorm-native_build-v2-20260927.py:/work/metta-device-wide-source/metta_training/native_build.py:ro" \
            -v "$disk/native-advnorm-learner-python-v1-20260927.py:/work/metta-device-wide-source/metta_training/learner.py:ro" \
            -v "$disk/native-advnorm-advantage.cuh-20260927:/work/metta-device-wide-source/metta_training/native/advantage.cuh:ro" \
            -v "$disk/native-advnorm-learner-v3-20260927.cuh:/work/metta-device-wide-source/metta_training/native/learner.cuh:ro" \
            -v "$disk/native-advnorm-replay-v2-20260927.cuh:/work/metta-device-wide-source/metta_training/native/replay.cuh:ro" \
            -v "$disk/native_puffer_policy-fixed-prior-20260927.py:/work/source-normalized-16245/integrations/native_puffer_policy.py:ro" \
            -v "$disk/metta_puffer-terminal-boundary-fixed-20260927.py:/work/source-normalized-16245/integrations/metta_puffer.py:ro" \
            -v "$disk/puffer_codec-calibrated-v1.py:/work/source-normalized-16245/integrations/puffer_codec.py:ro" \
            -v /var/tmp/relh-generals-jax-cache:/cache \
            -v /tmp/relh-generals-gpu/runtime:/work/runtime:ro \
            -v /tmp/relh-generals-gpu/source-gpu:/work/oldsource:ro -w /work \
            -e XDG_CACHE_HOME=/recovery-output/cache \
            -e PYTHONPATH=/work/metta-device-wide-source:/work/runtime:/work/source-normalized-16245:/work/oldsource \
            -e JAX_COMPILATION_CACHE_DIR=/cache -e JAX_PLATFORMS=cuda,cpu -e XLA_PYTHON_CLIENT_PREALLOCATE=false \
            -e LD_LIBRARY_PATH=/work/runtime/nvidia/cu13/lib \
            relh-generals-b300:20260923b python /recovery/evaluate_coworld_frozen_greedy-advnorm-20260927.py \
            --native --build /recovery/native-raw-advnorm-build-v5-26943/build/build.json \
            --run /recovery/native-raw-advnorm-r4-ent0-8m-v5-26947/run \
            --checkpoint "${checkpoint/$disk/\/recovery}" --sha256 "$digest" \
            --games 1024 --pool-size 1024 --seed 1386 --opponent "$opponent" --sample-seed 1451 --reward-diagnostics \
            --output "/recovery-output/$tag-$opponent" > "$out/$tag-$opponent.log" 2>&1
        python3 - "$out/$tag-$opponent/evaluation.json" <<'PYSCORE'
import json,sys
r=json.load(open(sys.argv[1]));print(r['opponent'],r['checkpoint_sha256'],r['wins'],r['losses'],r['draws'],r['score'],flush=True)
PYSCORE
    done
done
NODE
