#!/usr/bin/env bash
#SBATCH --job-name=relh-classic-native-policy-intervention
#SBATCH --partition=b300
#SBATCH --nodelist=metta-fabric-b300-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBATCH --time=00:35:00
#SBATCH --nice=100
#SBATCH --chdir=/tmp
#SBATCH --output=/var/tmp/relh-generals-recovery/native-policy-intervention-%j.log
set -euo pipefail

python3 - /var/tmp/relh-generals-recovery <<'STAGEPY'
import base64,sys
from pathlib import Path
path=Path(sys.argv[1])/"evaluate_coworld_frozen_greedy-intervention-20260927.py"
data=base64.b64decode("")
if path.exists():
    assert path.read_bytes()==data
else:
    with path.open("xb") as handle:
        handle.write(data)
STAGEPY

python3 - /var/tmp/relh-generals-recovery <<'STAGEPY'
import base64,sys
from pathlib import Path
path=Path(sys.argv[1])/"launch_native_feedforward_intervention-20260927.py"
data=base64.b64decode("")
if path.exists():
    assert path.read_bytes()==data
else:
    with path.open("xb") as handle:
        handle.write(data)
STAGEPY

srun --nodes=1 --ntasks=1 --gres=gpu:1 --cpus-per-task=16 bash -c '
set -euo pipefail
w=/tmp/relh-generals-coworld
disk=/var/tmp/relh-generals-recovery
out=$disk/native-policy-intervention-$SLURM_JOB_ID
mkdir -p "$out"
printf "%s  %s\n" 24034ec915b7b91a8a3e9333ce12b3dcbd9e517c0eb7c828cdf500c297d2fc06 "$w/metta-device-wide-source.tar.gz" | sha256sum -c -
printf "%s  %s\n" 17171d409be5d618b85ac6578f43576876e96f1e86ade540bb9f2a07c0f661a2 "$disk/metta_puffer-terminal-boundary-fixed-20260927.py" | sha256sum -c -
printf "%s  %s\n" 020dbafc66861496295787330361b07e0492c892805594105fdbb050dcbb37f5 "$disk/puffer_codec-calibrated-v1.py" | sha256sum -c -
printf "%s  %s\n" e5691723d137e61a44db53c6dd20eac8050b8e7be732c3045e4fe207c0238519 "$disk/native_puffer_policy-feedforward-20260927.py" | sha256sum -c -
printf "%s  %s\n" 25ec6d1b0f7c08012a58681ce44b5721143f6da10c78b6cf50e9dac01f7d9ccf "$disk/puffer-native-feedforward-20260927.py" | sha256sum -c -
printf "%s  %s\n" 01137d8c30a38e31fcf14388f336841a7d1033c702f4add28855478760778323 "$disk/evaluate_coworld_frozen_greedy-intervention-20260927.py" | sha256sum -c -
printf "%s  %s\n" 1ffdcf2dbb89ca062044de59926c546b80d5f94b8e8237605a0e5dd2883762d3 "$disk/launch_native_feedforward_intervention-20260927.py" | sha256sum -c -
run=native-policy-feedforward-state-fixed-134m-probe-26604
build=native-policy-feedforward-state-fixed-33m-probe-v2-26484
relative_checkpoint=checkpoints/metta_generals/run/0000000134217728.bin
digest=95a3e18dad11b3d8c97537fd7b135d89f391bc84139df7c382ac5226cfc0e095
printf "%s  %s\n" "$digest" "$disk/$run/run/$relative_checkpoint" | sha256sum -c -
test -f "$disk/$run/run/completed.json"
IFS=, read -r -a allocated_gpus <<< "$SLURM_STEP_GPUS"
test "${#allocated_gpus[@]}" -eq 1
usage=$(nvidia-smi --query-gpu=uuid,memory.used,utilization.gpu --format=csv,noheader,nounits)
mapfile -t rows <<< "$usage"
test "${#rows[@]}" -eq 1
IFS=, read -r gpu memory utilization <<< "${rows[0]}"
gpu=${gpu//[[:space:]]/}
memory=${memory//[[:space:]]/}
utilization=${utilization//[[:space:]]/}
[[ "$gpu" == GPU-* && "$memory" =~ ^[0-9]+$ && "$utilization" =~ ^[0-9]+$ ]]
(( memory < 2048 && utilization < 20 ))
name=relh-classic-native-policy-intervention-$SLURM_JOB_ID
cleanup() { docker stop -t 5 "$name" >/dev/null 2>&1 || true; }
trap cleanup EXIT
trap "exit 143" TERM
for mode in split move; do
    flag=--force-hint-split
    if [[ "$mode" == move ]]; then flag=--force-hint-move; fi
    for opponent in expander_harvester sentinel strong_mixed; do
        timeout -k 30s 5m docker run --rm --name "$name" --gpus "device=$gpu" --cpus=16 \
            --ulimit core=0:0 --user "$(id -u):$(id -g)" \
            -v "$w:/work" -v "$out:/recovery-output" -v "$disk:/recovery" \
            -v "$disk/native_puffer_policy-feedforward-20260927.py:/work/source-normalized-16245/integrations/native_puffer_policy.py:ro" \
            -v "$disk/metta_puffer-terminal-boundary-fixed-20260927.py:/work/source-normalized-16245/integrations/metta_puffer.py:ro" \
            -v "$disk/puffer_codec-calibrated-v1.py:/work/source-normalized-16245/integrations/puffer_codec.py:ro" \
            -v /var/tmp/relh-generals-jax-cache:/cache \
            -v /tmp/relh-generals-gpu/runtime:/work/runtime:ro \
            -v /tmp/relh-generals-gpu/source-gpu:/work/oldsource:ro -w /work \
            -e XDG_CACHE_HOME=/recovery-output/cache \
            -e PYTHONPATH=/work/metta-device-wide-source:/work/runtime:/work/source-normalized-16245:/work/oldsource \
            -e JAX_COMPILATION_CACHE_DIR=/cache -e JAX_PLATFORMS=cuda,cpu \
            -e XLA_PYTHON_CLIENT_PREALLOCATE=false -e LD_LIBRARY_PATH=/work/runtime/nvidia/cu13/lib \
            relh-generals-b300:20260923b python /recovery/launch_native_feedforward_intervention-20260927.py \
            --native --build "/recovery/$build/build/build.json" --run "/recovery/$run/run" \
            --checkpoint "/recovery/$run/run/$relative_checkpoint" --sha256 "$digest" \
            --games 1024 --pool-size 1024 --seed 1386 --opponent "$opponent" "$flag" \
            --output "/recovery-output/$mode-$opponent" > "$out/$mode-$opponent.log" 2>&1
        cat "$out/$mode-$opponent/evaluation.json"
    done
done
'
