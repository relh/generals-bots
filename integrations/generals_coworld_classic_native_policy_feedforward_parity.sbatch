#!/usr/bin/env bash
#SBATCH --job-name=relh-classic-native-policy-feedforward-parity
#SBATCH --partition=b300
#SBATCH --nodelist=metta-fabric-b300-1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBATCH --time=00:12:00
#SBATCH --nice=2147483645
#SBATCH --chdir=/tmp
#SBATCH --output=/var/tmp/relh-generals-recovery/native-policy-feedforward-parity-%j.log
set -euo pipefail

# Mandatory user policy: verify lowest scheduling priority before workload startup.
slurm_task_priority_record=$(scontrol show job -o "${SLURM_JOB_ID:?}")
[[ " $slurm_task_priority_record " == *" Nice=2147483645 "* ]] || { printf 'Lowest Slurm Nice verification failed\n' >&2; exit 1; }
slurm_task_priority=unknown
for slurm_task_field in $slurm_task_priority_record; do
  case "$slurm_task_field" in Priority=*) slurm_task_priority=${slurm_task_field#Priority=} ;; esac
done
[[ "$slurm_task_priority" =~ ^[0-9]+$ ]] || exit 1
printf 'SLURM_PRIORITY_READBACK JobId=%s Nice=2147483645 Priority=%s\n' "$SLURM_JOB_ID" "$slurm_task_priority" >&2
unset slurm_task_priority_record slurm_task_field

python3 - /var/tmp/relh-generals-recovery <<'STAGEPY'
import base64,sys
from pathlib import Path
path=Path(sys.argv[1])/"verify_native_puffer_policy-feedforward-20260927.py"
data=base64.b64decode("")
if path.exists():
    assert path.read_bytes()==data
else:
    with path.open("xb") as f:
        f.write(data)
STAGEPY
python3 - /var/tmp/relh-generals-recovery <<'STAGEPY'
import base64,sys
from pathlib import Path
path=Path(sys.argv[1])/"verify_native_puffer_backward-feedforward-20260927.py"
data=base64.b64decode("")
if path.exists():
    assert path.read_bytes()==data
else:
    with path.open("xb") as f:
        f.write(data)
STAGEPY
srun --nice=2147483645 --nodes=1 --ntasks=1 --gres=gpu:1 --cpus-per-task=16 bash -c '
set -euo pipefail
w=/tmp/relh-generals-coworld
job=$SLURM_JOB_ID
disk=/var/tmp/relh-generals-recovery
run=native-policy-feedforward-state-fixed-33m-probe-v2-26484
out=$disk/native-policy-feedforward-parity-$job
mkdir -p "$out"
printf "%s  %s\n" 51b626e72d2373efd436e6f9ed914d17ab60985fab091b0d01cf885a92ed97c7 "$disk/verify_native_puffer_policy-feedforward-20260927.py" | sha256sum -c -
printf "%s  %s\n" a6c89a3f6ab5fe720373f79e685131a4ecef2c28ff0967c3814dcc986134fe92 "$disk/verify_native_puffer_backward-feedforward-20260927.py" | sha256sum -c -
printf "%s  %s\n" e5691723d137e61a44db53c6dd20eac8050b8e7be732c3045e4fe207c0238519 "$disk/native_puffer_policy-feedforward-20260927.py" | sha256sum -c -
test -f "$disk/$run/run/completed.json"
printf "%s  %s\n" be80b8ad266d43eda19993b40f52bbffc00e307e3fff728444dfc1614b0a6876 "$disk/$run/run/checkpoints/metta_generals/run/0000000033554432.bin" | sha256sum -c -
usage=$(nvidia-smi --query-gpu=uuid,memory.used,utilization.gpu --format=csv,noheader,nounits)
mapfile -t rows <<< "$usage"
test "${#rows[@]}" -eq 1
IFS=, read -r gpu memory utilization <<< "${rows[0]}"
gpu=${gpu//[[:space:]]/}
memory=${memory//[[:space:]]/}
utilization=${utilization//[[:space:]]/}
[[ "$gpu" == GPU-* && "$memory" =~ ^[0-9]+$ && "$utilization" =~ ^[0-9]+$ ]]
(( memory < 2048 && utilization < 20 ))
name=relh-classic-native-policy-feedforward-parity-$job
cleanup() { docker stop -t 5 "$name" >/dev/null 2>&1 || true; }
trap cleanup EXIT
trap "exit 143" TERM
timeout -k 30s 10m docker run --rm --name "$name" --gpus "device=$gpu" --cpus=16 \
 --ulimit core=0:0 --user "$(id -u):$(id -g)" \
 -v "$w:/work" -v "$out:/recovery-output" -v "$disk:/recovery" \
 -v "$disk/native_puffer_policy-feedforward-20260927.py:/work/source-normalized-16245/integrations/native_puffer_policy.py:ro" \
 -v /var/tmp/relh-generals-jax-cache:/cache \
 -v "$disk/metta_puffer-terminal-boundary-fixed-20260927.py:/work/source-normalized-16245/integrations/metta_puffer.py:ro" \
 -v "$disk/puffer_codec-calibrated-v1.py:/work/source-normalized-16245/integrations/puffer_codec.py:ro" \
 -v /tmp/relh-generals-gpu/runtime:/work/runtime:ro -v /tmp/relh-generals-gpu/source-gpu:/work/oldsource:ro -w /work \
 -e XDG_CACHE_HOME=/recovery-output/cache -e PYTHONPATH=/work/metta-device-wide-source:/work/runtime:/work/source-normalized-16245:/work/oldsource \
 -e JAX_COMPILATION_CACHE_DIR=/cache -e JAX_PLATFORMS=cuda,cpu -e XLA_PYTHON_CLIENT_PREALLOCATE=false \
 -e LD_LIBRARY_PATH=/work/runtime/nvidia/cu13/lib \
 relh-generals-b300:20260923b bash -c "
 python /recovery/verify_native_puffer_policy-feedforward-20260927.py \
  --source /recovery/$run/build/source --build /recovery/$run/build/build.json \
  --training /recovery/$run/run/training.json \
  --checkpoint /recovery/$run/run/checkpoints/metta_generals/run/0000000033554432.bin \
  --sha256 be80b8ad266d43eda19993b40f52bbffc00e307e3fff728444dfc1614b0a6876 \
  --output /recovery-output/forward --public-views &&
 python /recovery/verify_native_puffer_backward-feedforward-20260927.py \
  --source /recovery/$run/build/source --build /recovery/$run/build/build.json \
  --training /recovery/$run/run/training.json \
  --checkpoint /recovery/$run/run/checkpoints/metta_generals/run/0000000033554432.bin \
  --sha256 be80b8ad266d43eda19993b40f52bbffc00e307e3fff728444dfc1614b0a6876 \
  --output /recovery-output/backward" > "$out/container.log" 2>&1
cat "$out/forward/parity.json"
cat "$out/backward/parity.json"

'
